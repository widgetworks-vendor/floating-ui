{
  "name": "@popperjs/core",
  "version": "2.11.6",
  "description": "Tooltip and Popover Positioning Engine",
  "type": "module",
  "module": "lib/index.js",
  "author": "Federico Zivolo <federico.zivolo@gmail.com>",
  "license": "MIT",
  "repository": "github:popperjs/popper-core",
  "keywords": [
    "tooltip",
    "popover",
    "dropdown",
    "popup",
    "popper",
    "positioning engine"
  ],
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/popperjs"
  },
  "files": [
    "index.d.ts",
    "/dist",
    "/lib"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf lib && rimraf dist && rimraf test/visual/dist",
    "xtest": "yarn test:unit && yarn test:functional",
    "xtest:unit": "jest --coverage src",
    "xtest:functional": "DEV_PORT=`get-port` jest tests/functional",
    "xtest:typescript": "tsc --project tests/typescript/tsconfig.json",
    "dev": "NODE_ENV=dev concurrently 'yarn serve' 'yarn build:dev --watch'",
    "serve": "serve -l 5000 tests/visual",
    "build": "yarn clean && yarn build:typescript",
    "build:typescript": "rimraf dist/typescript; tsc --project ./tsconfig.json",
    "tsc": "tsc --project ./tsconfig.json"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "typescript": "^5.9.3"
  }
}
